# Copy this file to .env and fill in the required values. Values below are the
# complete set of Docker-configurable application settings.
# If Jellyfin runs on the Docker host, Docker Desktop users can use
# http://host.docker.internal:8096 rather than localhost.

# Required service credentials (Compose rejects missing or empty values)
JELLYFIN_URL=
JELLYFIN_API_KEY=
TPDB_EMAIL=
TPDB_PASSWORD=
# Optional metadata lookup
TMDB_API_KEY=

# Container image version. Use a numbered release when available.
IMAGE_TAG=latest

# App user and new-file permissions (Unraid nobody:users defaults).
PUID=99
PGID=100
UMASK=022

# Security and diagnostics
# Required by Compose. Use a long, random value, for example from:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DEBUG=false
TPDB_DEBUG_SNAPSHOTS=false

# Web server (Compose always binds the published port to 127.0.0.1.)
WEB_PORT=5001

# TPDb endpoints (normally leave these defaults unchanged)
TPDB_BASE_URL=https://theposterdb.com
TPDB_SEARCH_URL_TEMPLATE=https://theposterdb.com/search?term={query}

# Poster search and worker tuning
MAX_POSTERS_PER_ITEM=18
MAX_TPDB_SETS_PER_ITEM=30
TPDB_BATCH_DELAY_SEC=1.5
TPDB_PICKER_CACHE_MAX_AGE_DAYS=7

# Compose uses WEB_PORT above for both the app and the localhost published port.
# It sets WEB_HOST=0.0.0.0 inside the container and APP_STATE_DIR, CACHE_DIR,
# and LOG_DIR to /app/data, /app/cache, and /app/logs. Other file paths derive
# from those directories in config_example.py. Edit compose.yaml if you need
# a different container layout.
